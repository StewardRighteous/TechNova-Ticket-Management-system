        "browser": "Chrome 128.0 / Edge 128.0",
        "operatingSystem": "macOS Sonoma 14.5 / Windows 11",
        "device": "MacBook Pro / Dell Latitude",
        "errorMessage": "HTTP 400 Bad Request - Invalid Audience Claim: aud mismatch",
        "errorCode": "ERR_AUTH_AUDIENCE_MISMATCH",
        "stepsToReproduce": "1. Log into portal via Okta SAML/SSO.\n2. Wait for 15-minute token TTL expiry.\n3. Trigger silent refresh background call.\n4. Observe infinite 302 redirect back to auth handler.",
        "expectedBehavior": "Token introspection returns a renewed short-lived JWT without disrupting session state.",
        "actualBehavior": "Backend rejects request with 400 Bad Request, triggering client app route reload loop."
