      "id": "TCK-1084",
      "code": "TCK-1084",
      "title": "OAuth2 Token Refresh Loop on Multi-tenant Dashboard",
      "description": "Users authenticating via enterprise SSO encounter an infinite 302 redirect loop when JWT access token expires. The refresh token rotation payload returns HTTP 400 Bad Request due to mismatched audience claim in token introspection endpoint.",
      "companyId": "comp-1",
      "companyName": "Apex Financial Services Inc.",
      "companyCode": "AF",
      "contactId": "cnt-101",
      "serviceId": "srv-1",
      "serviceName": "Custom Web Applications & SaaS",
      "categoryId": "cat-bug-auth",
      "priority": "P1 Urgent",
      "status": "In Progress",
      "channel": "whatsapp",
      "channelIdentifier": "WhatsApp Dispatch #WA-8841",
      "clientContact": "Marcus Reed (CFO)",
      "assignedToId": "emp-4",
      "assignedToName": "Evelyn Shaw",
      "assignedToRole": "Senior Support Specialist",
      "teamId": "team-t2-support",
      "currentStageRole": "development_team",
      "slaDeadline": "34 mins remaining",
